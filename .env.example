# ==============================================================================
# ALUMNI TRACKER — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Bu dosya bir şablondur. Projeyi çalıştırmadan önce:
# 1. Bu dosyanın bir kopyasını oluşturup adını `.env` yapın:
#    cp .env.example .env          (Linux/macOS)
#    copy .env.example .env        (Windows)
#    cp .env.example server/.env   (Server klasörü için)
# 2. Aşağıdaki değerleri kendi ortamınıza göre güncelleyin.
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Database Connection URL (PostgreSQL)
# - Yerel (Local) geliştirme için: postgresql://postgres:postgres@localhost:5432/alumni_db?schema=public
# - Docker Compose içi için:      postgresql://postgres:postgres@db:5432/alumni_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alumni_db?schema=public

# Security / JWT Secret Key (Üretim ortamında güçlü bir anahtar ile değiştirin)
JWT_SECRET=your_jwt_secret_key_change_in_production
